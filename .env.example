# <template:vars>
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
PGURI=postgres://dota:dota@localhost:5432/dota
LOG_LEVEL=info
SERVER_PORT=3000
# </template:vars>

WORKER_PORT=3001

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=dota
CLICKHOUSE_PASSWORD=dota
CLICKHOUSE_DATABASE=dota
CHURI=clickhouse://dota:dota@localhost:9000/dota

# Empty endpoint talks to AWS. Set a URL only for S3-compatible stores.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=datalouna-dota-replays
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

LIVE_POLL_INTERVAL_MS=3000
LIVE_MISSING_THRESHOLD=2
HISTORY_PAGE_SIZE=100
HISTORY_DETAILS_ENQUEUE_LIMIT=500
HISTORY_REPLAY_ENQUEUE_LIMIT=50
SEQ_BATCH_SIZE=100
STEAM_API_MIN_INTERVAL_MS=1000
HISTORY_NEWEST_REFRESH_MS=3600000
HISTORY_EXHAUSTED_REFRESH_MS=86400000
REPLAY_LIVE_DELAY_MS=1800000

# Сид одного Steam-аккаунта в БД при старте worker/api.
# Пароль и секреты не коммитить. STEAM_SEED_API_KEY — пул Web API (shared_secret
# не обязателен). GC берёт готовые аккаунты без ключа и без shared_secret.
STEAM_SEED_LOGIN=
STEAM_SEED_PASSWORD=
STEAM_SEED_API_KEY=
STEAM_SEED_SHARED_SECRET=
STEAM_SEED_IDENTITY_SECRET=
