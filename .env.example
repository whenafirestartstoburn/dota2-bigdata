# <template:vars>
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
PGURI=postgres://dota:dota@localhost:5432/dota
LOG_LEVEL=info
SERVER_PORT=3000
# </template:vars>

WORKER_PORT=3001
PARSER_PORT=3002

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=dota
CLICKHOUSE_PASSWORD=dota
CLICKHOUSE_DATABASE=dota
CHURI=clickhouse://dota:dota@localhost:9000/dota

# Empty endpoint talks to AWS. Set a URL only for S3-compatible stores.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=datalouna-dota-replays
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# Сид одного Steam-аккаунта в БД при старте worker/api.
# Пароль и секреты не коммитить. STEAM_SEED_API_KEY — пул Web API (shared_secret
# не обязателен). GC берёт готовые аккаунты без ключа и без shared_secret.
STEAM_SEED_LOGIN=
STEAM_SEED_PASSWORD=
STEAM_SEED_API_KEY=
STEAM_SEED_SHARED_SECRET=
STEAM_SEED_IDENTITY_SECRET=

# Dark Shopping (dark.shopping) marketplace. Empty key disables POST /api/buy-account.
DARK_SHOPPING_BASE_URL=https://dark.shopping
DARK_SHOPPING_API_KEY=
