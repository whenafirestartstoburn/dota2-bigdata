# <template:vars>
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
PGURI=postgres://dota:dota@localhost:5432/dota
LOG_LEVEL=info
SERVER_PORT=3000
# </template:vars>

WORKER_PORT=3001
# live | historical | match-processing | all (local default)
WORKER_ROLE=all
# Compose replicas for worker-historical. 0 = do not run history walk.
WORKER_HISTORICAL_REPLICAS=0
PARSER_PORT=3002

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=dota
CLICKHOUSE_PASSWORD=dota
CLICKHOUSE_DATABASE=dota
CHURI=clickhouse://dota:dota@localhost:9000/dota

# Plain bucket + keys = S3 API (empty S3_ENDPOINT talks to AWS).
# gs://bucket/ = GCS via the instance service account; keys may be empty.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=datalouna-dota-replays
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# After parse: move .dem.bz2 to cold storage. Empty S3_ARCHIVE_BUCKET = same
# as S3_BUCKET. Dev (dota2-bigdata): same bucket, prefix cold/. Prod: set a
# separate bucket and S3_ARCHIVE_STORAGE_CLASS (STANDARD_IA / GLACIER_IR /
# COLDLINE / ARCHIVE). Empty prefix keeps replays/… at the dest bucket root.
S3_ARCHIVE_BUCKET=
S3_ARCHIVE_PREFIX=cold/
S3_ARCHIVE_STORAGE_CLASS=
S3_ARCHIVE_ENDPOINT=
S3_ARCHIVE_REGION=
S3_ARCHIVE_ACCESS_KEY=
S3_ARCHIVE_SECRET_KEY=

# Сид одного Steam-аккаунта в БД при старте worker/api.
# Пароль и секреты не коммитить. STEAM_SEED_API_KEY — пул Web API (shared_secret
# не обязателен). GC берёт готовые аккаунты без ключа и без shared_secret.
STEAM_SEED_LOGIN=
STEAM_SEED_PASSWORD=
STEAM_SEED_API_KEY=
STEAM_SEED_SHARED_SECRET=
STEAM_SEED_IDENTITY_SECRET=

# Dark Shopping (dark.shopping) marketplace. Empty key disables POST /api/buy-account.
DARK_SHOPPING_BASE_URL=https://dark.shopping
DARK_SHOPPING_API_KEY=
