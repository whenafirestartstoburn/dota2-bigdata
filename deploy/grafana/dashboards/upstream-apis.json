{
  "uid": "dota-upstream",
  "title": "Valve APIs (Steam / GC / Replay CDN)",
  "tags": ["dota2", "steam", "gc", "replay"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Steam API RPS",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(dota_webapi_requests_total[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Steam success",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(dota_webapi_requests_total{result=\"success\"}[5m])) / clamp_min(sum(rate(dota_webapi_requests_total[5m])), 1e-9)",
          "legendFormat": "ok",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GC RPS",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(dota_gc_requests_total[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "GC success",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(dota_gc_requests_total{result=\"success\"}[5m])) / clamp_min(sum(rate(dota_gc_requests_total[5m])), 1e-9)",
          "legendFormat": "ok",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Replay CDN RPS",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(dota_replay_downloads_total{method=\"GetReplay\",result!=\"already_stored\"}[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "orange", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Replay success",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(dota_replay_downloads_total{method=\"GetReplay\",result=\"success\"}[5m])) / clamp_min(sum(rate(dota_replay_downloads_total{method=\"GetReplay\",result=~\"success|not_found|error\"}[5m])), 1e-9)",
          "legendFormat": "ok",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Steam Web API (api.steampowered.com + GetLeagueInfoList)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Steam API RPS per method",
      "description": "Logical calls per second, one line per Web API method (GetLiveLeagueGames, GetTopLiveGame, GetRealtimeStats, GetMatchHistory, GetMatchHistoryBySequenceNum, GetLeagueInfoList, datafeed lists).",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method) (rate(dota_webapi_requests_total[5m]))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": true },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Steam API response time per method",
      "description": "Mean and p95 wall time of a logical call, including in-process retries.",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method) (rate(dota_webapi_request_duration_seconds_sum[5m])) / clamp_min(sum by (method) (rate(dota_webapi_request_duration_seconds_count[5m])), 1e-9)",
          "legendFormat": "mean {{method}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(dota_webapi_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{method}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "spanNulls": true },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Steam API statuses per method",
      "description": "Result class per method: success, http_403, http_429, http_4xx, http_5xx, timeout, transport, proxy, parse, public_match, error.",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method, result) (rate(dota_webapi_requests_total[5m]))",
          "legendFormat": "{{method}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "last"] }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Game Coordinator (CMsgGCMatchDetailsRequest)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "GC RPS per method",
      "description": "CMsgGCMatchDetailsRequest rate. Sparse traffic still shows as a bump, then idle at 0 — not a lifetime counter.",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method) (rate(dota_gc_requests_total[5m]))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": true },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "GC response time per method",
      "description": "Windowed mean and p95. Includes session bind when the worker had to reconnect before send.",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method) (rate(dota_gc_request_duration_seconds_sum[5m])) / clamp_min(sum by (method) (rate(dota_gc_request_duration_seconds_count[5m])), 1e-9)",
          "legendFormat": "mean {{method}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(dota_gc_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{method}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "spanNulls": true },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "GC statuses per method",
      "description": "success, timeout, no_account, error. Logons are a separate metric (dota_gc_logons_total).",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method, result) (rate(dota_gc_requests_total[5m]))",
          "legendFormat": "{{method}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "last"] }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "GC logons",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(dota_gc_logons_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": true },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "GC session up",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "dota_gc_session_up",
          "legendFormat": "session",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "spanNulls": true },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Valve demo records (replay*.valve.net GetReplay)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Replay CDN RPS",
      "description": "download_replay outcomes per second. already_stored is a local S3 hit, not a Valve GET.",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method) (rate(dota_replay_downloads_total{method=\"GetReplay\",result!=\"already_stored\"}[5m]))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": true },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Replay CDN response time",
      "description": "Mean and p95 of download_replay, including already_stored short-circuit and 404 retries.",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method) (rate(dota_replay_download_duration_seconds_sum[5m])) / clamp_min(sum by (method) (rate(dota_replay_download_duration_seconds_count[5m])), 1e-9)",
          "legendFormat": "mean {{method}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(dota_replay_download_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{method}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "spanNulls": true },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] }
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Replay CDN statuses",
      "description": "success, already_stored, not_found (404 / unpublished cluster), error.",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method, result) (rate(dota_replay_downloads_total{method=\"GetReplay\"}[5m]))",
          "legendFormat": "{{method}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "last"] }
