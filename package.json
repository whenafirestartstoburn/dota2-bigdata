{
	"name": "dota2-collector",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.10",
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@clickhouse/client": "^1.12.1",
			"drizzle-orm": "rc",
			"graphile-worker": "^0.16.6",
			"pino": "^10.3.1",
			"steam-session": "^1.9.4",
			"steam-user": "^5.2.3",
			"zod": "^4.4.3"
		}
	},
	"scripts": {
		"typecheck": "tsc -p packages/shared && tsc -p packages/api && tsc -p packages/cli && tsc -p packages/worker",
		"api": "bun run --watch --no-clear-screen packages/api/src/app.ts",
		"ch": "dbmate --env CHURI -d db/clickhouse/migrations -s db/clickhouse/schema.sql",
		"ch:down": "bun run ch -- down",
		"ch:new": "bun run ch -- new",
		"ch:up": "bun run ch -- up",
		"db:down": "dbmate --env PGURI down",
		"db:new": "dbmate --env PGURI new",
		"db:pull": "bun --env-file=.env run scripts/db-pull.ts",
		"db:up": "dbmate --env PGURI up",
		"lint": "biome check packages/*/src packages/*/tests scripts",
		"lint:fix": "biome check --write packages/*/src packages/*/tests scripts",
		"worker": "bun run packages/worker/src/app.ts",
		"steam:guard": "bun run packages/cli/src/steam-guard.ts",
		"steam:import": "bun run packages/cli/src/import-accounts.ts",
		"steam:proxies": "bun run packages/cli/src/import-proxies.ts",
		"parser:fetch-patches": "bun run --env-file=.env packages/cli/src/fetch-patch-replays.ts",
		"catalogs:sync": "bun run --env-file=.env packages/cli/src/sync-catalogs.ts",
		"test": "NODE_ENV=development bun test packages/*/tests"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/bun": "^1.3.14",
		"drizzle-kit": "^1.0.0-rc.4",
		"pino-pretty": "^13.1.3",
		"typescript": "^7.0.2"
	}
}
