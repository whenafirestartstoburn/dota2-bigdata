node_modules
# Шаблоном, а не одним именем: .env.production и .env.local несут те же
# PGURI и секреты, что и локальный .env, и под правило `.env` не подпадают.
.env*
!.env.example
.proxies.local
.accounts*.local
*.log
.DS_Store
# Локальные настройки редактора. Сами скиллы блоков (.claude/skills/**)
# коммитятся: они часть проекта, а не машины.
.claude/settings.local.json

# Справочные материалы — не часть собираемого сервиса.
template/
notion_data/
example_projects/

# Replay fixtures for the Go parser (tens of MB each).
packages/parser/testdata/demos/*.dem
packages/parser/testdata/demos/*.dem.bz2
packages/parser/testdata/patches/**/*.dem
packages/parser/testdata/patches/**/*.dem.bz2

# Postgres / ClickHouse volumes, если compose пишет рядом.
.data/
