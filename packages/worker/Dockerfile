# syntax=docker/dockerfile:1-labs

# Строка выше — директива парсера, а не комментарий, и обязана быть
# ПЕРВОЙ: обычный комментарий перед ней закрывает блок директив, после
# чего она читается как текст. Нужна она ради COPY --parents — он живёт
# в labs-канале фронтенда Dockerfile и синтаксисом по умолчанию не
# разбирается вовсе.
#
# Контекст сборки — корень монорепозитория, а не каталог пакета:
#   docker build -f packages/worker/Dockerfile -t worker .
FROM oven/bun:1-alpine

RUN apk add --no-cache bzip2

WORKDIR /app

# Манифесты копируются ВСЕ, а не только нужные этому сервису: bun.lock
# описывает все воркспейсы разом, и отсутствующий
# packages/<пакет>/package.json bun считает изменением дерева. Отказ
# приходит от --production: заморозку лок-файла он включает неявно.
#
# --parents сохраняет packages/<пакет>/ в пути назначения — без него
# Docker схлопнул бы все манифесты в одно имя. Копируется именно
# манифест, а не пакет целиком: иначе слой установки терял бы кеш от
# правки любого исходника.
COPY package.json bun.lock ./
COPY --parents packages/*/package.json ./

# --filter сужает установку до этого сервиса и его workspace-зависимостей:
# соседние пакеты в образ не ставятся.
RUN bun install --frozen-lockfile --production --filter "@app/worker"

ENV NODE_ENV=production

# Внутри маркеров пишет генератор: список исходников и переменные порта
# зависят от набора блоков и обновляются на `template add`. Свои шаги
# (сертификаты, healthcheck, дополнительные COPY) дописываются СНАРУЖИ —
# внутри они будут перетёрты.
#
# Сгенерированный код приезжает в образ уже собранным: реестр
# SQL-доменов и типы запросов лежат под src/ и обязаны быть
# закоммичены. Пересобрать их внутри нельзя — генераторы импортируют
# код, который на верхнем уровне модуля разбирает окружение и ходит в
# базу, а ни того, ни другого при сборке образа нет.
# <template:runtime>
COPY packages/worker/src ./packages/worker/src
COPY packages/shared/src ./packages/shared/src

ENV WORKER_PORT=8080
# </template:runtime>

CMD ["bun", "packages/worker/src/app.ts"]
